# Nach .env kopieren. CHANGE_ME-Werte muessen vor dem ersten Start ersetzt werden.
# Der Server benoetigt nur diese .env, docker-compose.yml und Zugriff auf die Images.

# Bei bestehenden Installationen den bisherigen Compose-Projektnamen beibehalten.
# Ein neuer Name wuerde andere Container und Datenbank-Volumes verwenden.
COMPOSE_PROJECT_NAME=semaporter

# Von GitHub Actions veroeffentlichte Portal-Images. Fuer reproduzierbare Releases
# statt "latest" einen Release- oder sha-Tag aus GHCR einsetzen.
PORTAL_IMAGE_REGISTRY=ghcr.io/midniqhtvibes/semaporter
PORTAL_IMAGE_TAG=latest
PORTAL_PULL_POLICY=always

POSTGRES_DB=semaporter
POSTGRES_USER=semaporter
# URL-sichere Zufallszeichen verwenden, weil der Wert auch Bestandteil der DATABASE_URL ist.
# Geeignet sind beispielsweise 48 zufaellige Hex-Zeichen.
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

PORTAL_SECRET_KEY=CHANGE_ME_RANDOM_64_CHARACTERS
# URL-safe Base64 aus 32 Zufallsbytes; Erzeugungsbefehle siehe README.
PORTAL_FERNET_KEY=CHANGE_ME_FERNET_KEY

# Nur fuer die initiale Anlage setzen. Nach dem ersten erfolgreichen Login koennen
# E-Mail und Passwort geleert werden; bestehende Benutzer werden nie ueberschrieben.
PORTAL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PORTAL_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
PORTAL_BOOTSTRAP_ADMIN_NAME=Portal Administrator

# Produktive Sitzungseinstellungen. Nur fuer einen ausdruecklich gewollten
# HTTP-Betrieb ohne TLS muss PORTAL_COOKIE_SECURE=false gesetzt werden.
PORTAL_COOKIE_SECURE=true
PORTAL_ALLOWED_HOSTS=portal.example.com,localhost,127.0.0.1
PORTAL_SESSION_HOURS=12
SEMAPHORE_REQUEST_TIMEOUT_SECONDS=30

# Optional: Vault unter Einstellungen -> Verbindungen -> Vault einrichten. Zugangsdaten werden
# dort verschluesselt gespeichert, nicht in Wizard-Entwuerfen oder dieser Datei.
VAULT_REQUEST_TIMEOUT_SECONDS=30
# Optionaler Pfad INNERHALB des Backend-Containers zu einer vertrauenswuerdigen
# CA-PEM-Datei. Die Datei zusaetzlich per Compose-Override read-only mounten.
VAULT_CA_BUNDLE=

# GitLab unter Einstellungen -> Verbindungen -> GitLab einrichten.
GITLAB_REQUEST_TIMEOUT_SECONDS=30
GITLAB_CA_BUNDLE=

# Das Frontend ist standardmaessig nur auf dem Host selbst direkt erreichbar.
PORTAL_BIND_ADDRESS=127.0.0.1
PORTAL_PUBLIC_PORT=8080

# Optionales Caddy-TLS-Gateway: docker compose --profile tls up -d
# PORTAL_DOMAIN muss als DNS-Name auf diesen Host zeigen. Caddy bezieht und erneuert
# das Zertifikat automatisch; Port 80 und 443 muessen von aussen erreichbar sein.
PORTAL_DOMAIN=portal.example.com
PORTAL_GATEWAY_BIND_ADDRESS=0.0.0.0
PORTAL_HTTP_PORT=80
PORTAL_HTTPS_PORT=443

# Begrenzung der lokalen Docker-Logs pro Container.
PORTAL_LOG_MAX_SIZE=10m
PORTAL_LOG_MAX_FILES=5
