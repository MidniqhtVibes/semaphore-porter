# Vor dem ersten Start nach .env kopieren und alle CHANGE_ME-Werte ersetzen.
POSTGRES_DB=semaphore_portal
POSTGRES_USER=semaphore_portal
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

PORTAL_SECRET_KEY=CHANGE_ME_RANDOM_64_CHARACTERS
# URL-safe Base64 aus 32 Zufallsbytes; Erzeugungsbefehle siehe README.
PORTAL_FERNET_KEY=CHANGE_ME_FERNET_KEY
PORTAL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PORTAL_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
PORTAL_BOOTSTRAP_ADMIN_NAME=Portal Administrator

# Hinter einem HTTPS-Reverse-Proxy true setzen. Fuer lokalen HTTP-Test false.
PORTAL_COOKIE_SECURE=false
PORTAL_ALLOWED_HOSTS=localhost,127.0.0.1
PORTAL_SESSION_HOURS=12
PORTAL_PUBLIC_PORT=8080
