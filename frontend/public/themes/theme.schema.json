{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "title":  "Semaphore Porter Theme",
    "description":  "Version 1: Design-Datei. Text- und Schaltflächenkontrast werden zusätzlich beim Import geprüft.",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_version",
                     "id",
                     "name",
                     "base"
                 ],
    "properties":  {
                       "schema_version":  {
                                              "const":  1
                                          },
                       "id":  {
                                  "type":  "string",
                                  "pattern":  "^[a-z0-9][a-z0-9-]{1,47}$"
                              },
                       "name":  {
                                    "type":  "string",
                                    "minLength":  1,
                                    "maxLength":  80
                                },
                       "description":  {
                                           "type":  "string",
                                           "maxLength":  240
                                       },
                       "base":  {
                                    "enum":  [
                                                 "github-dark",
                                                 "sit-light",
                                                 "sit-dark"
                                             ]
                                },
                       "font":  {
                                    "enum":  [
                                                 "system",
                                                 "sora"
                                             ]
                                },
                       "radius":  {
                                      "type":  "integer",
                                      "minimum":  0,
                                      "maximum":  16
                                  },
                       "colors":  {
                                      "type":  "object",
                                      "additionalProperties":  false,
                                      "properties":  {
                                                         "bg":  {
                                                                    "type":  "string",
                                                                    "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                },
                                                         "header":  {
                                                                        "type":  "string",
                                                                        "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                    },
                                                         "surface":  {
                                                                         "type":  "string",
                                                                         "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                     },
                                                         "surface-alt":  {
                                                                             "type":  "string",
                                                                             "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                         },
                                                         "surface-soft":  {
                                                                              "type":  "string",
                                                                              "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                          },
                                                         "hover":  {
                                                                       "type":  "string",
                                                                       "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                   },
                                                         "border":  {
                                                                        "type":  "string",
                                                                        "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                    },
                                                         "border-soft":  {
                                                                             "type":  "string",
                                                                             "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                         },
                                                         "text":  {
                                                                      "type":  "string",
                                                                      "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                  },
                                                         "muted":  {
                                                                       "type":  "string",
                                                                       "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                   },
                                                         "accent":  {
