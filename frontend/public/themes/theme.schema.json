                                                                        "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                    },
                                                         "accent-hover":  {
                                                                              "type":  "string",
                                                                              "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                          },
                                                         "accent-soft":  {
                                                                             "type":  "string",
                                                                             "pattern":  "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
