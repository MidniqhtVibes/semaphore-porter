                                                         "success-border":  {
                                                                                "type":  "string",
                                                                                "pattern":  "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                                                                            },
                                                         "warning":  {
                                                                         "type":  "string",
                                                                         "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                     },
                                                         "warning-soft":  {
                                                                              "type":  "string",
                                                                              "pattern":  "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                                                                          },
                                                         "warning-border":  {
                                                                                "type":  "string",
                                                                                "pattern":  "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                                                                            },
                                                         "danger":  {
                                                                        "type":  "string",
                                                                        "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                    },
                                                         "danger-soft":  {
                                                                             "type":  "string",
                                                                             "pattern":  "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                                                                         },
                                                         "danger-border":  {
                                                                               "type":  "string",
                                                                               "pattern":  "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                                                                           },
                                                         "danger-hover":  {
                                                                              "type":  "string",
                                                                              "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                          },
                                                         "on-danger":  {
                                                                           "type":  "string",
                                                                           "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                       },
                                                         "on-emphasis":  {
                                                                             "type":  "string",
                                                                             "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                         },
                                                         "overlay":  {
                                                                         "type":  "string",
                                                                         "pattern":  "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
                                                                     },
                                                         "selection":  {
                                                                           "type":  "string",
                                                                           "pattern":  "^#[0-9a-fA-F]{6}$"
                                                                       },
                                                         "on-selection":  {
